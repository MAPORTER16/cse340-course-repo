<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <ul>
        <% projects.forEach(project => { %>
            <li>
                <%= project.date.toLocaleDateString('en-US', { weekday: 'short', month: 'long', day: 'numeric', year: 'numeric' }) %>:
                <a href="/project/<%= project.project_id %>"><strong><%= project.title %></strong></a>
                (<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)
            </li>
        <% }); %>
    </ul>

</main>

<%- include('partials/footer') %>
