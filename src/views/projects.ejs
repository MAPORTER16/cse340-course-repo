<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Upcoming Service Projects</h2>
    <ul>
        <% projects.forEach(project => { %>
            <li>
                <%= project.date.toLocaleDateString('en-US', { weekday: 'short', month: 'long', day: 'numeric', year: 'numeric' }) %>:
                <strong><%= project.title %></strong> (<%= project.organization_name %>)
            </li>
        <% }); %>
    </ul>

</main>

<%- include('partials/footer') %>
