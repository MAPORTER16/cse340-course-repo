<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <% if (users.length === 0) { %>
        <p>No users have registered yet.</p>
    <% } else { %>
        <p>There <%= users.length === 1 ? 'is 1 registered user' : `are ${users.length} registered users` %>.</p>

        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Email (Username)</th>
                        <th scope="col">Role</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(account => { %>
                        <tr>
                            <td><%= account.name %></td>
                            <td><%= account.email %></td>
                            <td><span class="role role-<%= account.role_name || 'none' %>"><%= account.role_name || 'none' %></span></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } %>

    <p><a href="/dashboard">Back to Dashboard</a></p>
</main>
<%- include('partials/footer') %>
