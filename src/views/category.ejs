<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2><%= category.name %></h2>

    <% if (projects.length === 0) { %>
        <p>There are no service projects in this category yet.</p>
    <% } else { %>
        <p>Service projects in this category:</p>
        <ul>
            <% projects.forEach(project => { %>
                <li>
                    <%= project.date.toLocaleDateString('en-US', { weekday: 'short', month: 'long', day: 'numeric', year: 'numeric' }) %>:
                    <a href="/project/<%= project.project_id %>"><strong><%= project.title %></strong></a>
                    (<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)
                </li>
            <% }); %>
        </ul>
    <% } %>

</main>

<%- include('partials/footer') %>
